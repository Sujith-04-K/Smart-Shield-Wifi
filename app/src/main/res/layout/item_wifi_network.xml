<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="16dp"
    android:layout_marginVertical="6dp"
    app:cardCornerRadius="18dp"
    app:cardElevation="2dp"
    app:cardBackgroundColor="@color/surface"
    app:strokeColor="#FFFFFF"
    app:strokeWidth="1.2dp">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="16dp">

        <!-- SSID Title -->
        <TextView
            android:id="@+id/tvSsid"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="Campus_WiFi"
            android:textColor="@color/on_surface"
            android:textSize="17sp"
            android:textStyle="bold"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toStartOf="@id/tvRiskBadge"
            android:layout_marginEnd="8dp" />

        <!-- Trust Score Risk Badge (e.g. 88/100 • SAFE) -->
        <TextView
            android:id="@+id/tvRiskBadge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="88/100 • SAFE"
            android:textSize="12sp"
            android:textStyle="bold"
            android:paddingHorizontal="12dp"
            android:paddingVertical="5dp"
            android:background="@drawable/bg_badge_safe"
            android:textColor="@color/risk_safe"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <!-- BSSID & Frequency Band in Cyber Monospace style -->
        <TextView
            android:id="@+id/tvBssidBand"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="00:1A:2B:3C:4D:5E  •  5 GHz BAND"
            android:textColor="@color/on_surface_variant"
            android:textSize="12sp"
            android:typeface="monospace"
            android:layout_marginTop="6dp"
            app:layout_constraintTop_toBottomOf="@id/tvSsid"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <!-- Security Chip -->
        <TextView
            android:id="@+id/tvSecurity"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="WPA3"
            android:textSize="11sp"
            android:textStyle="bold"
            android:typeface="monospace"
            android:textColor="@color/primary"
            android:background="@color/primary_container"
            android:paddingHorizontal="10dp"
            android:paddingVertical="4dp"
            android:layout_marginTop="12dp"
            app:layout_constraintTop_toBottomOf="@id/tvBssidBand"
            app:layout_constraintStart_toStartOf="parent" />

        <!-- Vendor Chip -->
        <TextView
            android:id="@+id/tvVendor"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Vendor: TP-Link"
            android:textSize="11sp"
            android:textStyle="bold"
            android:textColor="#38BDF8"
            android:background="#0F2942"
            android:paddingHorizontal="10dp"
            android:paddingVertical="4dp"
            android:layout_marginStart="8dp"
            app:layout_constraintTop_toTopOf="@id/tvSecurity"
            app:layout_constraintBottom_toBottomOf="@id/tvSecurity"
            app:layout_constraintStart_toEndOf="@id/tvSecurity" />

        <!-- Signal Strength -->
        <TextView
            android:id="@+id/tvSignal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="RSSI: -58 dBm (84%)"
            android:textColor="@color/on_surface_variant"
            android:textSize="12sp"
            android:textStyle="bold"
            app:layout_constraintBottom_toBottomOf="@id/tvSecurity"
            app:layout_constraintTop_toTopOf="@id/tvSecurity"
            app:layout_constraintEnd_toEndOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>

</com.google.android.material.card.MaterialCardView>
