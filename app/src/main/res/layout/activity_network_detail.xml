<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background">

    <!-- Top App Bar -->
    <com.google.android.material.appbar.AppBarLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/surface"
        app:elevation="0dp">

        <androidx.appcompat.widget.Toolbar
            android:id="@+id/toolbarDetail"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            app:title="Trust Assessment Detail"
            app:titleTextColor="@color/on_surface"
            app:navigationIcon="@android:drawable/ic_menu_revert" />

    </com.google.android.material.appbar.AppBarLayout>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- Hero Assessment HUD Card -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="20dp"
                app:cardElevation="3dp"
                app:cardBackgroundColor="@color/surface"
                app:strokeColor="@color/cyber_cyan"
                app:strokeWidth="1.5dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:background="@drawable/bg_cyber_dashboard_card"
                    android:padding="20dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="⚡ XAI SECURITY AUDIT REPORT // v1.0"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:textColor="@color/primary"
                        android:background="@color/primary_container"
                        android:paddingHorizontal="10dp"
                        android:paddingVertical="4dp" />

                    <TextView
                        android:id="@+id/tvDetailSsid"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Campus_WiFi"
                        android:textSize="24sp"
                        android:textStyle="bold"
                        android:textColor="@color/on_surface"
                        android:layout_marginTop="8dp" />

                    <TextView
                        android:id="@+id/tvDetailBssid"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="BSSID: 00:1A:2B:3C:4D:5E"
                        android:textColor="@color/on_surface_variant"
                        android:textSize="13sp"
                        android:typeface="monospace"
                        android:layout_marginTop="2dp" />

                    <!-- Total Score Hero Badge -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginTop="16dp">

                        <TextView
                            android:id="@+id/tvDetailScoreBadge"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="88/100 • SAFE"
                            android:textSize="18sp"
                            android:textStyle="bold"
                            android:paddingHorizontal="16dp"
                            android:paddingVertical="8dp"
                            android:background="@drawable/bg_badge_safe"
                            android:textColor="@color/risk_safe" />

                        <TextView
                            android:id="@+id/tvDetailFreq"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:gravity="end"
                            android:text="5 GHz (5180 MHz)"
                            android:textColor="@color/on_surface_variant"
                            android:textSize="14sp"
                            android:typeface="monospace" />
                    </LinearLayout>

                    <!-- Confidence & Scan Timestamp Row -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginTop="12dp">

                        <TextView
                            android:id="@+id/tvDetailConfidence"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Confidence: HIGH"
                            android:textSize="13sp"
                            android:textStyle="bold"
                            android:textColor="@color/primary"
                            android:background="@color/primary_container"
                            android:paddingHorizontal="10dp"
                            android:paddingVertical="4dp" />

                        <TextView
                            android:id="@+id/tvDetailTimestamp"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:gravity="end"
                            android:text="Assessment Time: 27 Jul 2026, 2:45 PM"
                            android:textColor="@color/on_surface_variant"
                            android:textSize="12sp"
                            android:layout_gravity="center_vertical" />
                    </LinearLayout>

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- XAI Explainable Card: "Why Should I Trust This Network?" -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                app:cardCornerRadius="20dp"
                app:cardElevation="2dp"
                app:cardBackgroundColor="@color/surface"
                app:strokeColor="#FFFFFF"
                app:strokeWidth="1.2dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/why_trust_title"
                        android:textSize="17sp"
                        android:textStyle="bold"
                        android:textColor="@color/primary" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Weighted MCDA Assessment Criteria Breakdown:"
                        android:textSize="13sp"
                        android:textColor="@color/on_surface_variant"
                        android:layout_marginTop="4dp" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="@color/surface_variant"
                        android:layout_marginVertical="12dp" />

                    <!-- Dynamic Reasons Checklist Container -->
                    <LinearLayout
                        android:id="@+id/containerReasons"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical" />

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Potential Security Attacks Card -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                app:cardCornerRadius="20dp"
                app:cardElevation="2dp"
                app:cardBackgroundColor="@color/surface"
                app:strokeColor="#FF8585"
                app:strokeWidth="1.2dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="🚨 Potential Cyber Attacks &amp; Vulnerabilities"
                        android:textSize="17sp"
                        android:textStyle="bold"
                        android:textColor="#F87171" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Security vulnerabilities associated with this network's Trust Score &amp; ciphers:"
                        android:textSize="13sp"
                        android:textColor="@color/on_surface_variant"
                        android:layout_marginTop="4dp" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="@color/surface_variant"
                        android:layout_marginVertical="12dp" />

                    <!-- Container for Potential Attacks -->
                    <LinearLayout
                        android:id="@+id/containerAttacks"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical" />

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Security Tips Card -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                app:cardCornerRadius="20dp"
                app:cardElevation="2dp"
                app:cardBackgroundColor="@color/surface"
                app:strokeColor="#FFFFFF"
                app:strokeWidth="1.2dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Security Tips"
                        android:textSize="17sp"
                        android:textStyle="bold"
                        android:textColor="@color/secondary" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Practical security recommendations for safe browsing:"
                        android:textSize="13sp"
                        android:textColor="@color/on_surface_variant"
                        android:layout_marginTop="4dp" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="@color/surface_variant"
                        android:layout_marginVertical="12dp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="✓ Use HTTPS websites for sensitive transactions."
                        android:textSize="14sp"
                        android:textColor="@color/on_surface"
                        android:layout_marginBottom="6dp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="✓ Avoid online banking on unknown public Wi-Fi."
                        android:textSize="14sp"
                        android:textColor="@color/on_surface"
                        android:layout_marginBottom="6dp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="✓ Use a reliable VPN when connecting to open networks."
                        android:textSize="14sp"
                        android:textColor="@color/on_surface"
                        android:layout_marginBottom="6dp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="✓ Verify network SSID and security type with the administrator."
                        android:textSize="14sp"
                        android:textColor="@color/on_surface" />

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Action Buttons Card -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                app:cardCornerRadius="20dp"
                app:cardElevation="2dp"
                app:cardBackgroundColor="@color/surface"
                app:strokeColor="#FFFFFF"
                app:strokeWidth="1.2dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <!-- Mark as Verified Network Button -->
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnToggleVerified"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/mark_as_verified"
                        app:icon="@android:drawable/ic_menu_save"
                        app:cornerRadius="12dp" />

                    <!-- Save Scan Assessment Log to History Button -->
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnSaveHistory"
                        style="@style/Widget.Material3.Button.OutlinedButton"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Save Assessment to History"
                        android:layout_marginTop="8dp"
                        app:cornerRadius="12dp" />

                    <!-- Export PDF Security Report Button -->
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnExportPdf"
                        style="@style/Widget.Material3.Button.TonalButton"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="📄 Export PDF Security Audit Report"
                        android:layout_marginTop="8dp"
                        app:backgroundTint="#0284C7"
                        android:textColor="#FFFFFF"
                        app:cornerRadius="12dp" />

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
